<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/border_grey" />

        <TextView
            android:id="@+id/text_tooth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            tools:text=" Зъб 18"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Active Conditions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/active_conditions"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_active_conditions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            tools:listitem="@layout/item_active_condition" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="@color/divider_grey" />

        <!-- Add Condition -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/add_condition"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/container_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Confirmation Layout  -->
        <LinearLayout
            android:id="@+id/layout_confirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/text_selected_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                tools:text="Повърхности за Кариес:"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <!-- Surface Selector -->
            <LinearLayout
                android:id="@+id/container_surface_toggles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ToggleButton
                    android:id="@+id/toggle_m"
                    style="@style/SurfaceToggleStyle"
                    android:textOn="@string/surface_mesial"
                    android:textOff="@string/surface_mesial" />

                <ToggleButton
                    android:id="@+id/toggle_o"
                    style="@style/SurfaceToggleStyle"
                    android:textOn="@string/surface_occlusal"
                    android:textOff="@string/surface_occlusal" />

                <ToggleButton
                    android:id="@+id/toggle_d"
                    style="@style/SurfaceToggleStyle"
                    android:textOn="@string/surface_distal"
                    android:textOff="@string/surface_distal" />

                <ToggleButton
                    android:id="@+id/toggle_b"
                    style="@style/SurfaceToggleStyle"
                    android:textOn="@string/surface_vestibular"
                    android:textOff="@string/surface_vestibular" />

                <ToggleButton
                    android:id="@+id/toggle_l"
                    style="@style/SurfaceToggleStyle"
                    android:textOn="@string/surface_lingual"
                    android:textOff="@string/surface_lingual" />
            </LinearLayout>

            <!-- Surface Legend  -->
            <TextView
                android:id="@+id/text_surface_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/surface_legend"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/divider_grey" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/entry_context"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btn_context_appointment">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_context_previous"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/previous_work" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_context_appointment"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/current_treatment" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_condition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/save"
                android:textColor="@color/white"
                app:backgroundTint="@color/primary" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

