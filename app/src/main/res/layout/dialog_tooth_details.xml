<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/border_grey" />

        <TextView
            android:id="@+id/text_tooth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:text=" Зъб 18"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Active Conditions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Активни състояния"
            android:textColor="@color/text_hint_grey"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_active_conditions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            tools:listitem="@layout/item_active_condition" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="@color/divider_grey" />

        <!-- Add Condition -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Добави състояние"
            android:textColor="@color/text_hint_grey"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/container_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Surface Selector -->
        <LinearLayout
            android:id="@+id/layout_surface_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/text_selected_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Повърхности за Кариес:"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ToggleButton
                    android:id="@+id/toggle_m"
                    style="@style/SurfaceToggleStyle"
                    android:textOn="@string/surface_mesial"
                    android:textOff="@string/surface_mesial" />

                <ToggleButton
                    android:id="@+id/toggle_o"
                    style="@style/SurfaceToggleStyle"
                    android:textOn="@string/surface_occlusal"
                    android:textOff="@string/surface_occlusal" />

                <ToggleButton
                    android:id="@+id/toggle_d"
                    style="@style/SurfaceToggleStyle"
                    android:textOn="@string/surface_distal"
                    android:textOff="@string/surface_distal" />

                <ToggleButton
                    android:id="@+id/toggle_b"
                    style="@style/SurfaceToggleStyle"
                    android:textOn="@string/surface_vestibular"
                    android:textOff="@string/surface_vestibular" />

                <ToggleButton
                    android:id="@+id/toggle_l"
                    style="@style/SurfaceToggleStyle"
                    android:textOn="@string/surface_lingual"
                    android:textOff="@string/surface_lingual" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/surface_legend"
                android:textColor="@color/text_hint_grey"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_condition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Запази"
                app:backgroundTint="@color/bg_header_blue" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
